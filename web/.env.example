# Copy this file to web/.env.local (same folder) and fill in both values.
# .env.local is git-ignored. Never commit real values.
#
# Supabase dashboard > Project Settings > API Keys
#   VITE_SUPABASE_URL             = Project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY = the PUBLISHABLE key (sb_publishable_...) or legacy "anon" key
#
# NEVER put the secret (sb_secret_...) or service_role key here. Everything
# starting with VITE_ ships to every visitor's browser. The app refuses to
# start if it detects a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
